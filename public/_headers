/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=(), usb=(), serial=(), midi=(), display-capture=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://static.cloudflareinsights.com; connect-src 'self' https://api.web3forms.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://static.cloudflareinsights.com; img-src 'self' data: https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://imgquarry.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src https://www.googletagmanager.com; base-uri 'self'; form-action 'self' https://api.web3forms.com

# Permissions-Policy note: `interest-cohort=()` was the FLoC opt-out. FLoC is dead and the
# token is ignored by every current browser; its live replacement is `browsing-topics=()`.
# The extra denials cost nothing — the site uses none of these APIs.
#
# CSP note: widened for GA4 before any enforcement attempt. Google splits measurement across
# *.google-analytics.com and *.analytics.google.com, and gtag loads from *.googletagmanager.com;
# the previous list would have silently dropped hits the moment the policy went enforcing —
# i.e. the CSP would have taken analytics down and looked fine doing it. Widening a
# REPORT-ONLY policy changes no behaviour today.
# static.cloudflareinsights.com is listed defensively: the beacon is injected at the edge, not
# by our HTML (it is absent from a curl of the origin), so it can appear without a repo change.

# Build assets are content-hashed by Turbopack, so a rebuild changes the filename. Caching
# them for four hours with must-revalidate — the Cloudflare default this replaces — made every
# return visitor past that window revalidate every chunk against the origin for nothing.
# Safe by construction: a deploy invalidates by changing the hash, never by expiry.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The build-time share card is emitted as an EXTENSIONLESS file (out/opengraph-image), so
# Cloudflare types it application/octet-stream. Combined with the nosniff above, no crawler
# or social platform will render it — every OG/Twitter preview was blank. The bytes are a
# real 1200x630 PNG; this tells the edge what they are.
# Placed after /* deliberately: the later matching rule wins for a repeated header.
# Verify after any deploy that touches it:
#   curl -sSI https://betonplus.co.il/opengraph-image | grep -i content-type   # want image/png
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
